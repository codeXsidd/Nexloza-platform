# ============================================
# NexLoza Platform — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real credentials.

# ---------- Supabase ----------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------- MQTT Broker (EMQX) ----------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_BROKER_WS_PORT=8083
MQTT_BROKER_WSS_PORT=8084
MQTT_BROKER_DASHBOARD_PORT=18083
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=your-mqtt-admin-password

# ---------- AWS Bedrock (Claude AI) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514

# ---------- Alexa Smart Home ----------
ALEXA_CLIENT_ID=your-alexa-client-id
ALEXA_CLIENT_SECRET=your-alexa-client-secret
ALEXA_SKILL_ID=your-alexa-skill-id

# ---------- Google Home ----------
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- Push Notifications (FCM) ----------
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_KEY_PATH=./secrets/fcm-service-account.json

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=noreply@nexloza.com

# ---------- Application ----------
APP_URL=http://localhost:3000
APP_ENV=development
LOG_LEVEL=debug
